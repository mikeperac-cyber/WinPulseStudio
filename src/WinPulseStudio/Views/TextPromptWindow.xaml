<Window x:Class="WinPulseStudio.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinPulse Studio"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BgSecondaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border Padding="18,16" Background="{StaticResource BgSecondaryBrush}">
        <StackPanel>
            <TextBlock x:Name="TxtPrompt"
                       Text="Enter a value"
                       FontSize="12.5"
                       Foreground="#CBD5E1"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>
            <TextBox x:Name="TxtInput"
                     Background="{StaticResource BgInputBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     CaretBrush="#38BDF8"
                     BorderBrush="{StaticResource BorderSubtleBrush}"
                     BorderThickness="1"
                     Padding="10,7"
                     FontSize="13"
                     KeyDown="TxtInput_KeyDown"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" Click="BtnCancel_Click" Style="{StaticResource FluentButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Save" Click="BtnOk_Click" Style="{StaticResource AccentButtonStyle}" IsDefault="True" Padding="18,6"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
