<Window x:Class="WinPulseStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinPulse Control Studio v1.2 — Guided Windows Care with 100 Built-In Tools"
        Icon="Assets/app.ico"
        Width="1500"
        Height="920"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- ==================== TOP TELEMETRY & CONTROL HEADER ==================== -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#0284C7" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WinPulse Control Studio"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC"/>
                            <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.2 • 100 BUILT-IN TOOLS" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Guided care for your Windows PC — with a full advanced toolkit when you want it"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Live Telemetry Pills -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="WORKSTATION &amp; CPU" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TxtHostCpu" Text="Loading..." FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="PHYSICAL MEMORY" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TxtRamUsage" Text="Loading..." FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="SESSION PRIVILEGE" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TxtAdminStatus" Text="Checking..." FontSize="12" FontWeight="SemiBold" Foreground="#10B981"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Safety Lock -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSafetyLock"
                            Click="BtnSafetyLock_Click"
                            Style="{StaticResource FluentButtonStyle}"
                            Background="#064E3B"
                            BorderBrush="#10B981"
                            Padding="12,7"
                            ToolTip="Safety Lock ON blocks live changes everywhere in the app. Previews (-DryRun) and verification are always allowed.">
                        <TextBlock x:Name="TxtSafetyLockLabel"
                                   Text="🔒 Safety Lock: ON (Live changes blocked)"
                                   Foreground="#6EE7B7"
                                   FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN NAV + CONTENT ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT NAV RAIL -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="10,14">
                <StackPanel>
                    <Button x:Name="BtnNavHome"
                            Click="BtnNavHome_Click"
                            Style="{StaticResource FluentButtonStyle}"
                            Margin="0,0,0,8"
                            Padding="8,10"
                            Background="#0369A1"
                            BorderBrush="#38BDF8">
                        <StackPanel>
                            <TextBlock Text="🏠" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="Home" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnNavAdvanced"
                            Click="BtnNavAdvanced_Click"
                            Style="{StaticResource FluentButtonStyle}"
                            Margin="0,0,0,8"
                            Padding="8,10"
                            Background="Transparent"
                            BorderBrush="Transparent">
                        <StackPanel>
                            <TextBlock Text="🗂" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="Advanced" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnNavCommands"
                            Click="BtnNavCommands_Click"
                            Style="{StaticResource FluentButtonStyle}"
                            Margin="0,0,0,8"
                            Padding="8,10"
                            Background="Transparent"
                            BorderBrush="Transparent">
                        <StackPanel>
                            <TextBlock Text="📖" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="Commands" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnNavHistory"
                            Click="BtnNavHistory_Click"
                            Style="{StaticResource FluentButtonStyle}"
                            Padding="8,10"
                            Background="Transparent"
                            BorderBrush="Transparent">
                        <StackPanel>
                            <TextBlock Text="🕘" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="History" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ACTIVE VIEW -->
            <ContentControl x:Name="ContentHost" Grid.Column="1" Focusable="False"/>
        </Grid>

        <!-- ==================== BOTTOM STATUS BAR ==================== -->
        <Border Grid.Row="2"
                Background="#090D16"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtFooterStatus"
                           Text="Ready • Choose a goal on the Home screen to get started."
                           FontSize="11.5"
                           Foreground="#94A3B8"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtWorkspacePath"
                           Grid.Column="1"
                           Text="Workspace: detecting..."
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="11"
                           Foreground="#64748B"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
