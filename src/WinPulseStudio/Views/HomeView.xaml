<UserControl x:Class="WinPulseStudio.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgPrimaryBrush}"
             Foreground="{StaticResource TextPrimaryBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28">
            <TextBlock Text="What would you like to do today?"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#F8FAFC"/>
            <TextBlock Text="Pick a goal. WinPulse explains every step in plain language, simulates it first, and only applies changes when you say so."
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,6,0,22"
                       TextWrapping="Wrap"/>

            <ItemsControl x:Name="LstGoals">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Tag="{Binding}" Click="GoalCard_Click" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="{Binding Title}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{StaticResource BgCardBrush}"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="16,14">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#26354D"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#172554"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid Width="318" Height="112">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="38" CornerRadius="9" Background="#0F172A" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Icon}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#F8FAFC"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Subtitle}"
                                           FontSize="11.5"
                                           Foreground="#94A3B8"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,8"/>
                                <TextBlock Grid.Row="2"
                                           Text="{Binding Meta}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="#38BDF8"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="MY COLLECTIONS"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="2,24,0,4"/>
            <TextBlock Text="Reusable sets of tools you saved from Advanced Mode."
                       FontSize="11.5"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="2,0,0,10"/>

            <TextBlock x:Name="TxtEmptyCollections"
                       Text="No saved collections yet. Open Advanced Mode, filter the catalog, then click 'Save as Collection'."
                       FontSize="12"
                       Foreground="#64748B"
                       TextWrapping="Wrap"
                       Margin="2,0,0,0"/>

            <ItemsControl x:Name="LstCollections">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Tag="{Binding}" Click="CollectionCard_Click" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="{Binding Title}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="#111827"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="14,11">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#818CF8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Width="252">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="#F8FAFC"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="11"
                                           Foreground="#94A3B8"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding Meta}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="#818CF8"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Prefer full control? Switch to Advanced Mode in the sidebar for the complete 100-script catalog, filters, presets and the source editor."
                       FontSize="11.5"
                       Foreground="#64748B"
                       TextWrapping="Wrap"
                       Margin="2,26,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
