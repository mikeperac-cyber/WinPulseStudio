<UserControl x:Class="WinPulseStudio.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgPrimaryBrush}"
             Foreground="{StaticResource TextPrimaryBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Run History" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
            <TextBlock Text="Every verification, preview and applied change is recorded on this PC — newest first."
                       FontSize="12.5"
                       Foreground="#94A3B8"
                       Margin="0,4,0,14"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource BgInputBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtHistorySearch"
                             Grid.Column="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="#38BDF8"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             TextChanged="TxtHistorySearch_TextChanged"
                             ToolTip="Search by script ID, name or context"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <ComboBox x:Name="CmbMode" Width="130" SelectionChanged="FilterCombo_Changed" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="All modes" IsSelected="True"/>
                    <ComboBoxItem Content="Verify"/>
                    <ComboBoxItem Content="Preview"/>
                    <ComboBoxItem Content="Applied"/>
                </ComboBox>
                <ComboBox x:Name="CmbStatus" Width="120" Margin="8,0,0,0" SelectionChanged="FilterCombo_Changed" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="All results" IsSelected="True"/>
                    <ComboBoxItem Content="OK"/>
                    <ComboBoxItem Content="Failed"/>
                </ComboBox>
                <Button Content="Clear History"
                        Click="BtnClearHistory_Click"
                        Style="{StaticResource FluentButtonStyle}"
                        Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Border Background="{StaticResource BgSecondaryBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                    <ListBox x:Name="LstHistory"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="LstHistory_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="6,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayId}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding ScriptName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SummaryLine}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <Border Background="#0F172A" CornerRadius="4" Padding="7,2">
                                                            <TextBlock Text="{Binding ModeLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#172554"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>

                <TextBlock x:Name="TxtEmptyHistory"
                           Text="No runs recorded yet. Run a verification or a preview and it will appear here."
                           FontSize="12.5"
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="30"/>
            </Grid>

            <Border Grid.Column="1"
                    Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtDetailTitle" Text="Select a run" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtDetailMeta" Text="Details, exit code and output appear here." FontSize="11.5" Foreground="#38BDF8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtDetailSummary" Text="" FontSize="12" Foreground="#CBD5E1" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <Border Grid.Row="3" Background="#050811" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="7" Margin="0,10,0,10">
                        <TextBox x:Name="TxtDetailOutput"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#6EE7B7"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="11"
                                 Padding="10"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </Border>

                    <StackPanel Grid.Row="4" Orientation="Horizontal">
                        <Button x:Name="BtnRunAgain" Content="↻ Run this again" Click="BtnRunAgain_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" IsEnabled="False"/>
                        <Button Content="📋 Copy Report" Click="BtnCopyDetail_Click" Style="{StaticResource FluentButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
